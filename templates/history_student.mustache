{{!
    @template report_lifestory/history_student

    Context variables required for this template:
    * baseurl string - Base URL of the report page.
    * searchvalue string - Current search text, empty when no search was made.
    * searchresults array - Students matching the search, each with: id int, fullname string, email string.
    * hasstoredfeedback bool - Whether stored AI feedback exists for the selected student.
    * feedbackdateline string - Localized line stating when the feedback was generated, null when none exists.

    Example context (json):
    {
        "baseurl": "https://example.com/report/lifestory/index.php",
        "searchvalue": "Alpha",
        "searchresults": [
            { "id": 3, "fullname": "Alpha Alpine", "email": "alpha@example.com" }
        ],
        "hasstoredfeedback": true,
        "feedbackdateline": "Feedback generated on Monday, 24 August 2026, 10:00 AM"
    }
}}

<div class="mb-4 report_lifestory-form">
    <div class="d-flex align-items-center flex-wrap justify-content-between gap-3 report_lifestory-header">

        <div class="d-flex align-items-center flex-wrap gap-3 report_lifestory-actions">

            <div id="usersearch-wrapper" class="position-relative" style="min-width: 300px;">
                {{^selecteduser}}
                    <form method="get" {{#baseurl}}action="{{baseurl}}"{{/baseurl}} id="usersearchform">
                        <input type="text"
                               name="searchvalue"
                               id="usersearch"
                               class="form-control pe-4"
                               placeholder="{{#str}} searchusers, report_lifestory {{/str}}"
                               value="{{searchvalue}}"
                               autocomplete="off">

                        <div id="search-results"
                             class="position-absolute bg-white border rounded shadow-sm mt-1 w-100 d-none"
                             style="z-index: 1000; max-height: 300px; overflow-y: auto;">
                        </div>
                    </form>

                    {{#searchvalue}}
                    <ul class="list-unstyled mt-2 mb-0 report_lifestory-staticresults" data-region="static-search-results">
                        {{#searchresults}}
                        <li>
                            <a href="{{baseurl}}?userid={{id}}" class="d-block p-2 text-decoration-none border-bottom">
                                {{fullname}} <small class="text-muted">{{email}}</small>
                            </a>
                        </li>
                        {{/searchresults}}
                    </ul>
                    {{/searchvalue}}
                {{/selecteduser}}

                {{#selecteduser}}
                    <div class="d-flex align-items-center">
                        <input type="text"
                               class="form-control"
                               value="{{fullname}}"
                               readonly>
                        <a href="{{baseurl}}"
                           class="ms-2 text-primary text-decoration-underline"
                           style="white-space: nowrap;">
                            {{#str}} clearselection, report_lifestory {{/str}}
                        </a>
                    </div>
                {{/selecteduser}}
            </div>

            {{#hasuser}}
            <div class="d-flex align-items-center gap-2 ms-3 report_lifestory-actionbuttons">
                {{#cangeneratefeedback}}
                <a href="{{baseurl}}?userid={{userid}}&action=feedback&sesskey={{sesskey}}"
                    class="btn btn-primary me-2"
                    id="btn-feedback-ai">
                        <span class="me-1"><i class="fa fa-magic" aria-hidden="true"></i></span>
                        {{#hasstoredfeedback}}{{#str}} regeneratefeedback, report_lifestory {{/str}}{{/hasstoredfeedback}}{{^hasstoredfeedback}}{{#str}} generatefeedback, report_lifestory {{/str}}{{/hasstoredfeedback}}
                </a>
                {{/cangeneratefeedback}}
                <a href="{{baseurl}}?userid={{userid}}&action=csv&sesskey={{sesskey}}"
                   class="btn report_lifestory-btn-csv"
                   style="background:#217346 !important; background-color:#217346 !important; border:1px solid #1a5c38 !important; color:#fff !important;"
                   id="btn-csv-export">
                     <span class="me-1"><i class="fa fa-file-excel-o" aria-hidden="true"></i></span>
                     {{#str}} exportcsv, report_lifestory {{/str}}
                </a>
                {{#canexportpdf}}
                <form method="post" action="{{baseurl}}" class="d-inline-block mb-0">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <input type="hidden" name="userid" value="{{userid}}">
                    <input type="hidden" name="id" value="{{courseid}}">
                    <input type="hidden" name="action" value="pdf">
                    <button type="submit" class="btn report_lifestory-btn-pdf" style="background:#e53935 !important; background-color:#e53935 !important; border:1px solid #c62828 !important; color:#fff !important;" id="btn-pdf-export">
                        <span class="me-1"><i class="fa fa-file-pdf-o" aria-hidden="true"></i></span>
                        {{#str}} exportpdf, report_lifestory {{/str}}
                    </button>
                </form>
                {{/canexportpdf}}
            </div>
            {{/hasuser}}
        </div>

        {{#hasuser}}
        {{#headerlogo}}
        <a class="d-flex align-items-center ms-auto report_lifestory-logo" href="https://datacurso.com/" target="_blank" rel="noopener noreferrer">
            <img src="{{logourl}}" alt="{{alttext}}" class="report_lifestory-pluginlogo">
        </a>
        {{/headerlogo}}
        {{/hasuser}}
    </div>
</div>

{{^hasuser}}
<div class="alert alert-info report_lifestory-alert">
    {{#str}} selectuser, report_lifestory {{/str}}
</div>
{{/hasuser}}

{{#hasuser}}
    {{#showfeedback}}
    <div class="alert alert-info mb-4 p-3 report_lifestory-feedback">
        <h5 class="mb-3">{{#str}} feedbackfromai, report_lifestory {{/str}}</h5>
        {{#feedbackdateline}}<p class="text-muted small mb-2">{{feedbackdateline}}</p>{{/feedbackdateline}}
        <div class="bg-light p-3 rounded mb-0 report_lifestory-feedbackcontent">
            {{{feedback}}}
        </div>
    </div>
    {{/showfeedback}}

    {{#courses}}
    <div class="mb-5 report_lifestory-course">
        <h4 class="mb-3">{{fullname}}</h4>
        <div class="report-table border rounded p-3 bg-white shadow-sm">
            {{{reporthtml}}}
        </div>
    </div>
    {{/courses}}
{{/hasuser}}
