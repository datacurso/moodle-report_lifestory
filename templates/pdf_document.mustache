{{!
    @template report_lifestory/pdf_document

    Simple TCPDF-compatible HTML document with the AI feedback and the student grades per course.
    Styling is applied through inline attributes because TCPDF does not load stylesheets and the
    HTML validator does not allow style elements inside the body.

    Context variables required for this template:
    * title string - Document title.
    * studentlabel string - Label shown before the student name.
    * studentname string - Student full name.
    * feedbacktitle string - Heading of the AI feedback block.
    * feedbackhtml string - AI feedback already converted to safe HTML.
    * courses array - Courses to render, each with: name string, hasdata bool, sections array, total object or null.
      Each section has: name string, tasks array of rows, total row or null.
      Each row has: name, calculatedweight, grade, range, percentage, feedback, contributiontototal (all strings).

    Example context (json):
    {
        "title": "Student life story",
        "studentlabel": "Student",
        "studentname": "Alpha Alpine",
        "feedbacktitle": "AI feedback",
        "feedbackhtml": "<h2>Summary</h2><p>Consistent progress across courses.</p>",
        "courses": [
            {
                "name": "Mathematics",
                "hasdata": true,
                "sections": [
                    {
                        "name": "Algebra",
                        "tasks": [
                            {
                                "name": "Quiz 1",
                                "calculatedweight": "25.00",
                                "grade": "8.50",
                                "range": "0-10.00",
                                "percentage": "85.00",
                                "feedback": "Well done",
                                "contributiontototal": "21.25"
                            }
                        ],
                        "total": {
                            "name": "Algebra total",
                            "calculatedweight": "-",
                            "grade": "8.50",
                            "range": "0-10.00",
                            "percentage": "85.00",
                            "feedback": "",
                            "contributiontototal": "-"
                        }
                    }
                ],
                "total": {
                    "name": "Course total",
                    "calculatedweight": "-",
                    "grade": "85.00",
                    "range": "0-100.00",
                    "percentage": "85.00",
                    "feedback": "",
                    "contributiontototal": "-"
                }
            },
            {
                "name": "History",
                "hasdata": false,
                "sections": [],
                "total": null
            }
        ]
    }
}}
<h1 style="text-align: center;">{{title}}</h1>
<p><strong>{{studentlabel}}:</strong> {{studentname}}</p>
<h2>{{feedbacktitle}}</h2>
<div>{{{feedbackhtml}}}</div>
{{#courses}}
<h2>{{name}}</h2>
{{#hasdata}}
{{#sections}}
<h3>{{name}}</h3>
<table border="1" cellpadding="4" style="width: 100%; border-collapse: collapse; margin-top: 6px; margin-bottom: 12px;">
    <thead>
        <tr>
            <th style="background-color: #f1f3f4; font-weight: bold;">{{#str}} activity, report_lifestory {{/str}}</th>
            <th style="background-color: #f1f3f4; font-weight: bold;">{{#str}} calculatedweight, report_lifestory {{/str}}</th>
            <th style="background-color: #f1f3f4; font-weight: bold;">{{#str}} grade, report_lifestory {{/str}}</th>
            <th style="background-color: #f1f3f4; font-weight: bold;">{{#str}} range, report_lifestory {{/str}}</th>
            <th style="background-color: #f1f3f4; font-weight: bold;">{{#str}} percentage, report_lifestory {{/str}}</th>
            <th style="background-color: #f1f3f4; font-weight: bold;">{{#str}} feedback, report_lifestory {{/str}}</th>
            <th style="background-color: #f1f3f4; font-weight: bold;">{{#str}} contributiontototal, report_lifestory {{/str}}</th>
        </tr>
    </thead>
    <tbody>
        {{#tasks}}
        <tr>
            <td>{{name}}</td>
            <td>{{calculatedweight}}</td>
            <td>{{grade}}</td>
            <td>{{range}}</td>
            <td>{{percentage}}</td>
            <td>{{feedback}}</td>
            <td>{{contributiontototal}}</td>
        </tr>
        {{/tasks}}
        {{#total}}
        <tr>
            <td style="font-weight: bold;">{{name}}</td>
            <td style="font-weight: bold;">{{calculatedweight}}</td>
            <td style="font-weight: bold;">{{grade}}</td>
            <td style="font-weight: bold;">{{range}}</td>
            <td style="font-weight: bold;">{{percentage}}</td>
            <td style="font-weight: bold;">{{feedback}}</td>
            <td style="font-weight: bold;">{{contributiontototal}}</td>
        </tr>
        {{/total}}
    </tbody>
</table>
{{/sections}}
{{#total}}
<table border="1" cellpadding="4" style="width: 100%; border-collapse: collapse; margin-top: 6px; margin-bottom: 12px;">
    <thead>
        <tr>
            <th style="background-color: #f1f3f4; font-weight: bold;">{{#str}} coursetotal, report_lifestory {{/str}}</th>
            <th style="background-color: #f1f3f4; font-weight: bold;">{{#str}} calculatedweight, report_lifestory {{/str}}</th>
            <th style="background-color: #f1f3f4; font-weight: bold;">{{#str}} grade, report_lifestory {{/str}}</th>
            <th style="background-color: #f1f3f4; font-weight: bold;">{{#str}} range, report_lifestory {{/str}}</th>
            <th style="background-color: #f1f3f4; font-weight: bold;">{{#str}} percentage, report_lifestory {{/str}}</th>
            <th style="background-color: #f1f3f4; font-weight: bold;">{{#str}} feedback, report_lifestory {{/str}}</th>
            <th style="background-color: #f1f3f4; font-weight: bold;">{{#str}} contributiontototal, report_lifestory {{/str}}</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td style="font-weight: bold;">{{name}}</td>
            <td style="font-weight: bold;">{{calculatedweight}}</td>
            <td style="font-weight: bold;">{{grade}}</td>
            <td style="font-weight: bold;">{{range}}</td>
            <td style="font-weight: bold;">{{percentage}}</td>
            <td style="font-weight: bold;">{{feedback}}</td>
            <td style="font-weight: bold;">{{contributiontototal}}</td>
        </tr>
    </tbody>
</table>
{{/total}}
{{/hasdata}}
{{^hasdata}}
<p><em>{{#str}} pdfnocoursedata, report_lifestory {{/str}}</em></p>
{{/hasdata}}
{{/courses}}
{{^courses}}
<p>{{#str}} nocoursesavailable, report_lifestory {{/str}}</p>
{{/courses}}
