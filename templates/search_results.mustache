{{!
    @template report_lifestory/search_results

    Context variables required for this template:
    * students array - Students matching the search, each with: id int, fullname string, email string,
      profileimageurl string, initial string, baseurl string, courseid int.
    * hasmore bool - Whether more students match the search beyond the listed results.

    Example context (json):
    {
        "students": [
            {
                "id": 3,
                "fullname": "Alpha Alpine",
                "email": "alpha@example.com",
                "profileimageurl": "https://example.com/pluginfile.php/5/user/icon/f1",
                "initial": "A",
                "baseurl": "https://example.com/report/lifestory/index.php",
                "courseid": 0
            }
        ],
        "hasmore": false
    }
}}

{{#students}}
<a href="{{baseurl}}?userid={{id}}{{#courseid}}&id={{courseid}}{{/courseid}}"
   class="d-block p-2 text-decoration-none border-bottom search-item">
    <div class="d-flex align-items-center">
        {{#profileimageurl}}
            <img src="{{profileimageurl}}" alt="{{fullname}}"
                 class="rounded-circle me-3" width="40" height="40">
        {{/profileimageurl}}
        {{^profileimageurl}}
            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-3"
                 style="width:40px; height:40px; font-weight:bold;">
                {{initial}}
            </div>
        {{/profileimageurl}}

        <div>
            <div class="fw-bold">{{fullname}}</div>
            <small class="text-muted">{{email}}</small>
        </div>
    </div>
</a>
{{/students}}
{{#hasmore}}
<p class="text-muted small p-2 mb-0">{{#str}} searchmorematches, report_lifestory {{/str}}</p>
{{/hasmore}}
